# Supply-chain hardening: never run package install scripts (the npm worms of 2025-2026 spread through preinstall).
# The project is tested to work without them (esbuild's binary comes from its optional platform package).
ignore-scripts=true
# Pin exact versions when adding dependencies.
save-exact=true
# Fail at install time on an unsupported Node version (the project needs 22.13+).
engine-strict=true
