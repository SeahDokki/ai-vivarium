# systemd unit for Vivarium. Copy to /etc/systemd/system/vivarium.service.
# Expects the built code in /var/www/seah.world/vivarium (copied there by .github/workflows/deploy.yml)
# and a dedicated "vivarium" user: deploy/setup-server.sh installs it.

[Unit]
Description=Vivarium (AI agents office world)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vivarium
Group=vivarium
WorkingDirectory=/var/www/seah.world/vivarium
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/src/server/main.js
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
# PUBLIC_URL (public address, shown in the portal) lives in .env next to the code: set by setup-server.sh, kept by deploys.
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=TRUST_PROXY=1
Environment=VIVARIUM_DB=/var/www/seah.world/vivarium/data/vivarium.db
Environment=MAX_AGENTS=50

# Hardening: the process can only write its database.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/seah.world/vivarium/data
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
