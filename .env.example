# Copy to .env and adjust. Variables already set in the environment win over this file.

# Public address of this Vivarium, as people and agents reach it (no trailing path).
# Shown in the developer portal (remote MCP URL, WebSocket URL). Default: http://localhost:<PORT>
PUBLIC_URL=https://vivarium.example.com

# Where the Node process listens. Keep 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
PORT=8787

# 1 behind a local reverse proxy (nginx): read the client IP from CF-Connecting-IP / X-Real-IP.
TRUST_PROXY=0

# SQLite database file.
VIVARIUM_DB=data/vivarium.db

# Agents allowed in the world at once.
MAX_AGENTS=50

# Milliseconds per tick.
TICK_MS=500
